# If you add anything new here you need to also add it to
# docker-compose.yml

# Testing only (Mailhog)
MH_SENDMAIL_SMTP_ADDR=mail:1025
MH_STORAGE=maildir
MH_MAILDIR_PATH=/tmp

# So git can access files not on docker(?)
GIT_DISCOVERY_ACROSS_FILESYSTEM=1

# mysql
MYSQL_ROOT_PASSWORD=test
MYSQL_USER=pause
MYSQL_PASSWORD=test
MYSQL_DATABASE=pause

# Where the users are
AUTHEN_DATA_SOURCE_NAME=dbi:mysql:pause;host=mysql
AUTHEN_DATA_SOURCE_USER=pause
AUTHEN_DATA_SOURCE_PW=test

# Where module data etc lives. (For now... this must be the
# same as AUTHEN_DATA_SOURCE_NAME because of assumptions in
# insert_fixture.pl and docker-entrypoint.sh
MOD_DATA_SOURCE_NAME=dbi:mysql:pause;host=mysql
MOD_DATA_SOURCE_USER=pause
MOD_DATA_SOURCE_PW=test

# Email recipients for various things
ADMIN=pause@localhost.localdomain
CPAN_TESTERS=pause@localhost.localdomain
TO_CPAN_TESTERS=pause@localhost.localdomain
REPLY_TO_CPAN_TESTERS=pause@localhost.localdomain
GONERS_NOTIFY=pause@localhost.localdomain
P5P=pause@localhost.localdomain
UPLOAD=pause@localhost.localdomain
FTP=pause@localhost.localdomain

# Comma seperated list split out into arrayref
ADMINS=pause@localhost.localdomain

# PrivatePAUSE.pm config
ML_CHOWN_USER=nobody
ML_CHOWN_GROUP=nogroup
ML_MIN_INDEX_LINES=0
ML_MIN_FILES=0

RUNDATA=/usr/local/rundata

HAVE_PERLBAL=0
SLEEP=1

PAUSE_LOG=/var/log/paused.log
PAUSE_LOG_DIR=/var/log

NGINX_HOST=pause.localhost
INCOMING=http://pause.localhost/incoming/

RECAPTCHA_ENABLED=1
CHECKSUMS_SIGNING_ARGS=--homedir /root/.gnupg --clearsign --default-key
CHECKSUMS_SIGNING_KEY=A34B1DABBB49489C
BATCH_SIG_HOME=/root/.gnupg

# We want to create some test users in the db
CREATE_TEST_USERS=1
